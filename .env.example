# CampusConnect Environment Configuration
FLASK_SECRET_KEY=campusconnect-super-secure-production-key-2026
FLASK_CONFIG=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration (PostgreSQL primary, SQLite fallback if left blank)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/campusconnect_db
DATABASE_URL=

# University Email Allowlist
CAMPUS_EMAIL_DOMAINS=campusconnect.edu,student.campusconnect.edu,faculty.campusconnect.edu
CAMPUS_EMAIL_DOMAIN=campusconnect.edu

# Campus Geolocation Defaults (for Leaflet.js map)
CAMPUS_CENTER_LAT=42.3601
CAMPUS_CENTER_LNG=-71.0942
CAMPUS_DEFAULT_ZOOM=16

# Mail Server Configuration (Console log fallback enabled in development mode)
MAIL_SERVER=localhost
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=CampusConnect Notifications <noreply@campusconnect.edu>

# Uploads and Security
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=16777216
SOCKETIO_MESSAGE_QUEUE=
